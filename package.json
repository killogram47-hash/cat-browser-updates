{
  "name": "cat-browser",
    "version": "1.0.7",
  "description": "Cat Browser - A Google-like search application",
  "main": "main.js",
  "author": "Cat Browser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder -mwl",
    "dist:win": "electron-builder --win nsis --publish never",
    "release:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "electron-updater": "latest"
  },
  "build": {
    "appId": "com.catbrowser.app",
    "productName": "Cat Browser",
    "publish": {
      "provider": "generic",
      "url": "${env.CAT_UPDATE_URL}"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
